<?xml version="1.0" encoding="UTF-8" ?>

<Application
    x:Class="ECORUTA_RAEE.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Paleta de colores -->
            <Color x:Key="ForestGreen">#123D2B</Color>
            <Color x:Key="PrimaryGreen">#218653</Color>
            <Color x:Key="LimeGreen">#B7F36B</Color>
            <Color x:Key="PageBackground">#F4F7F4</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#1D2B22</Color>
            <Color x:Key="TextSecondary">#718078</Color>
            <Color x:Key="BorderColor">#E1E9E2</Color>
            <Color x:Key="ErrorColor">#C62828</Color>

            <!-- Fondo general -->
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource PageBackground}" />
            </Style>

            <!-- Títulos -->
            <Style x:Key="PageTitle" TargetType="Label">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor"
                        Value="{StaticResource ForestGreen}" />
            </Style>

            <!-- Texto secundario -->
            <Style x:Key="Subtitle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor"
                        Value="{StaticResource TextSecondary}" />
            </Style>

            <!-- Botón principal -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource PrimaryGreen}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="54" />
                <Setter Property="Padding" Value="18,12" />
            </Style>

            <!-- Botón secundario -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#E7F0E9" />
                <Setter Property="TextColor"
                        Value="{StaticResource ForestGreen}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>

            <!-- Campos de entrada -->
            <Style x:Key="ModernEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="#F7F9F7" />
                <Setter Property="TextColor"
                        Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="#98A49B" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <!-- Tarjetas -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource CardBackground}" />
                <Setter Property="Stroke"
                        Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="20" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding" Value="20" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
