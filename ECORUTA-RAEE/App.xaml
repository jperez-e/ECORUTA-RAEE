<?xml version="1.0" encoding="UTF-8" ?>

<Application
    x:Class="ECORUTA_RAEE.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Fondo general -->
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource PageBackground}" />
            </Style>

            <!-- Títulos -->
            <Style x:Key="PageTitle" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor"
                        Value="{StaticResource ForestGreen}" />
            </Style>

            <!-- Texto secundario -->
            <Style x:Key="Subtitle" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor"
                        Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="BrandButton" TargetType="Button">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource DisabledBackground}" />
                                    <Setter Property="TextColor" Value="{StaticResource DisabledText}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Botón principal -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BrandButton}">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource PrimaryGreen}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="54" />
                <Setter Property="Padding" Value="18,12" />
            </Style>

            <!-- Botón secundario -->
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BrandButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryBackground}" />
                <Setter Property="TextColor"
                        Value="{StaticResource ForestGreen}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>

            <Style x:Key="SectionHeading" TargetType="Label" BasedOn="{StaticResource PageTitle}">
                <Setter Property="FontSize" Value="20" />
            </Style>
            <Style x:Key="MetricValue" TargetType="Label" BasedOn="{StaticResource PageTitle}">
                <Setter Property="FontSize" Value="23" />
            </Style>
            <Style x:Key="OnGreen" TargetType="Label">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
            </Style>
            <Style x:Key="CanvasVisual" TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource NightCanvas}}" />
            </Style>
            <Style x:Key="TituloVisual" TargetType="Label" BasedOn="{StaticResource SectionHeading}">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ForestGreen}, Dark={StaticResource NightInk}}" />
            </Style>
            <Style x:Key="TextoVisual" TargetType="Label" BasedOn="{StaticResource Subtitle}">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}" />
            </Style>
            <Style x:Key="TarjetaVisual" TargetType="Border" BasedOn="{StaticResource CardBorder}">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource NightSurface}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource NightBorder}}" />
                <Setter Property="Padding" Value="14" />
            </Style>
            <Style x:Key="PanelVisual" TargetType="Border" BasedOn="{StaticResource SoftPanel}">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryBackground}, Dark={StaticResource NightRaised}}" />
            </Style>
            <Style x:Key="AccionVisual" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="HeightRequest" Value="-1" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryBackground}, Dark={StaticResource NightRaised}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ForestGreen}, Dark={StaticResource NightInk}}" />
            </Style>
            <Style x:Key="PrincipalVisual" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="HeightRequest" Value="-1" />
                <Setter Property="MinimumHeightRequest" Value="52" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>
            <Style x:Key="CampoVisual" TargetType="Entry" BasedOn="{StaticResource ModernEntry}">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource NightMuted}}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource EntryBackground}, Dark={StaticResource NightRaised}}" />
                <Setter Property="HeightRequest" Value="-1" />
                <Setter Property="MinimumHeightRequest" Value="52" />
            </Style>
            <Style x:Key="CabeceraVisual" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#154F30, Dark=#163F2B}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style x:Key="GreenHero" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryGreen}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="Padding" Value="18,16" />
            </Style>
            <Style x:Key="SoftPanel" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryBackground}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style x:Key="ProgressTrack" TargetType="ProgressBar">
                <Setter Property="HeightRequest" Value="8" />
                <Setter Property="ProgressColor" Value="{StaticResource AccentGreen}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryBackground}" />
            </Style>
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource ErrorBackground}" />
                <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
            </Style>

            <!-- Campos de entrada -->
            <Style x:Key="ModernEntry" TargetType="Entry">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="BackgroundColor" Value="{StaticResource EntryBackground}" />
                <Setter Property="TextColor"
                        Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <!-- Tarjetas -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource CardBackground}" />
                <Setter Property="Stroke"
                        Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="20" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding" Value="20" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
