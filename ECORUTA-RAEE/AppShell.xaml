<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ECORUTA_RAEE.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ECORUTA_RAEE.Views"
    FlyoutBehavior="Flyout">

    <ShellContent
        Title="Inicio"
        Icon="home.png"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />

    <ShellContent
        Title="Solicitudes"
        Icon="list.png"
        ContentTemplate="{DataTemplate views:SolicitudesPage}"
        Route="SolicitudesPage" />

    <ShellContent
        Title="Nueva solicitud"
        Icon="add.png"
        ContentTemplate="{DataTemplate views:SolicitudFormPage}"
        Route="SolicitudFormPage" />

</Shell>