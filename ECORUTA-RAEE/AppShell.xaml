<?xml version="1.0" encoding="UTF-8" ?>
    
<Shell
    x:Class="ECORUTA_RAEE.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ECORUTA_RAEE.Views"
    FlyoutBehavior="Flyout">

    <FlyoutItem
        Title="Inicio"
        Route="inicio">

        <ShellContent
            Title="Inicio"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePage" />

    </FlyoutItem>

    <FlyoutItem
        Title="Solicitudes"
        Route="solicitudes">

        <ShellContent
            Title="Solicitudes"
            ContentTemplate="{DataTemplate views:SolicitudesPage}"
            Route="SolicitudesPage" />

    </FlyoutItem>

    <MenuItem
        Text="Cerrar sesión"
        Clicked="CerrarSesion_Clicked" />

</Shell>