<?xml version="1.0" encoding="utf-8" ?>
    
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ECORUTA_RAEE.Views.HomePage"
             Title="Inicio"
             BackgroundColor="#F5F7F6">

    <ScrollView>

        <VerticalStackLayout
            Padding="22"
            Spacing="20">

            <Label
                   Text="Bienvenido a EcoRuta👋"
                    FontSize="27"
                    FontAttributes="Bold"
                    TextColor="#176B3A"/>

            <Label
                Text="Organiza la recogida de residuos electrónicos."
                FontSize="14"
                TextColor="#718078"/>

            <Border
                Padding="20"
                BackgroundColor="White"
                Stroke="#E1E7E3"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Solicitudes registradas"
                        FontSize="15"
                        TextColor="#718078"/>
                    

                    <Label
                        x:Name="TotalSolicitudesLabel"
                        Text="0"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="#1B8A4B"/>

            <Label
                        Text="Total durante esta sesión"
                        FontSize="12"
                        TextColor="#718078"/>
        </VerticalStackLayout>
        </Border>

            <Button
                Text="+ Nueva solicitud"
                BackgroundColor="#1B8A4B"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="52"
                Clicked="NuevaSolicitud_Clicked"/>

            <Button
                Text="Ver solicitudes"
                BackgroundColor="#E0EFE5"
                TextColor="#176B3A"
                CornerRadius="12"
                HeightRequest="52"
                Clicked="VerSolicitudes_Clicked"/>


        </VerticalStackLayout>

    </ScrollView>

</ContentPage>