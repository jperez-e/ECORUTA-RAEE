<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ECORUTA_RAEE.Views.JornadaDetallePage"
    Title="Jornada">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <ActivityIndicator IsVisible="{Binding Ocupado}" IsRunning="{Binding Ocupado}"
                               Color="{StaticResource PrimaryGreen}" SemanticProperties.Description="Procesando jornada" />
            <Border IsVisible="{Binding HayMensaje}" Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource ErrorBackground}">
                <Label Text="{Binding Mensaje}" TextColor="{StaticResource ErrorColor}" />
            </Border>
            <Border IsVisible="{Binding HayConfirmacion}" Style="{StaticResource SoftPanel}" BackgroundColor="{StaticResource SuccessBackground}">
                <Label Text="{Binding Confirmacion}" TextColor="{StaticResource PrimaryGreen}" />
            </Border>

            <Border IsVisible="{Binding EsVistaPrevia}" Style="{StaticResource CardBorder}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Vista previa" Style="{StaticResource Subtitle}" />
                    <Label Text="{Binding Disponibilidad.Zona}" Style="{StaticResource PageTitle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Label Text="{Binding Disponibilidad.Cantidad, StringFormat='{0} solicitudes disponibles'}"
                               Style="{StaticResource Subtitle}" />
                        <Label Grid.Column="1" Text="{Binding Disponibilidad.Peso, StringFormat='{0:0.##} kg disponibles'}"
                               Style="{StaticResource Subtitle}" />
                    </Grid>
                    <Label Text="{Binding Disponibilidad.EstadoUmbral}" TextColor="{StaticResource PrimaryGreen}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding TieneDetalle}" Style="{StaticResource GreenHero}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Jornada.Estado}" Value="Cancelada">
                        <Setter Property="BackgroundColor" Value="{StaticResource ForestGreen}" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Jornada.Estado}" Style="{StaticResource OnGreen}" />
                    <Label Text="{Binding Jornada.Nombre}" Style="{StaticResource OnGreen}" FontSize="25" />
                    <Label Text="{Binding Jornada.FechaCreacion, StringFormat='Creada el {0:dd/MM/yyyy}'}"
                           Style="{StaticResource OnGreen}" />
                    <Label Text="{Binding Jornada.FechaProgramada, StringFormat='Programada para el {0:dd/MM/yyyy}'}"
                           Style="{StaticResource OnGreen}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Label Text="{Binding Jornada.CantidadSolicitudes, StringFormat='{0} solicitudes'}"
                               Style="{StaticResource OnGreen}" />
                        <Label Grid.Column="1" Text="{Binding Jornada.PesoTotal, StringFormat='{0:0.##} kg vigentes'}"
                               Style="{StaticResource OnGreen}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HayCoordenadasIncompletas}" Style="{StaticResource SoftPanel}"
                    BackgroundColor="{StaticResource WarningBackground}">
                <Label TextColor="{StaticResource WarningText}"
                       Text="{Binding CoordenadasIncompletas, StringFormat='Jornada con {0} ubicaciones incompletas. Consulta los puntos antes de la recogida en campo.'}" />
            </Border>
            <Border IsVisible="{Binding PuedePlanificar}" Style="{StaticResource CardBorder}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Orden sugerido de recogida" Style="{StaticResource SectionHeading}" />
                    <Label Text="{Binding EstadoRuta}" Style="{StaticResource Subtitle}" />
                    <Button Text="{Binding AccionRuta}" Command="{Binding PlanificarRutaCommand}"
                            IsEnabled="{Binding PuedeInteractuar}" Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Ver ruta en el mapa" Clicked="AbrirMapa_Clicked"
                    IsVisible="{Binding TieneDetalle}" IsEnabled="{Binding PuedeInteractuar}"
                    Style="{StaticResource SecondaryButton}" />

            <Label Text="{Binding ListaParadasTitulo}" Style="{StaticResource SectionHeading}" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Paradas}">
                <BindableLayout.EmptyView>
                    <Border Style="{StaticResource SoftPanel}">
                        <Label Text="Esta jornada no tiene solicitudes para mostrar." Style="{StaticResource Subtitle}" />
                    </Border>
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Style="{StaticResource SoftPanel}" Padding="8" MinimumWidthRequest="38"
                                        VerticalOptions="Start" BackgroundColor="{StaticResource PrimaryGreen}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Orden}" Value="0">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Orden}" Style="{StaticResource OnGreen}" HorizontalOptions="Center"
                                           SemanticProperties.Description="{Binding Orden, StringFormat='Parada {0}'}" />
                                </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="{Binding Solicitud.CodigoSolicitud}" Style="{StaticResource Subtitle}" />
                                <Label Text="{Binding Solicitud.DireccionReferencia}" TextColor="{StaticResource TextPrimary}"
                                       FontAttributes="Bold" FontSize="16" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Label Text="{Binding Solicitud.Zona}" Style="{StaticResource Subtitle}" />
                                    <Label Grid.Column="1" Text="{Binding Solicitud.PesoTotalEstimado, StringFormat='{0:0.##} kg vigentes'}"
                                           Style="{StaticResource Subtitle}" />
                                </Grid>
                                <Label IsVisible="{Binding TieneDistancia}"
                                       Text="{Binding DistanciaKm, StringFormat='{0:0.###} km geográficos desde la parada anterior'}"
                                       Style="{StaticResource Subtitle}" />
                                <Button Text="Editar solicitud"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PuedePlanificar}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarSolicitudCommand}"
                                        CommandParameter="{Binding Solicitud}" Style="{StaticResource SecondaryButton}" />
                            </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border IsVisible="{Binding EsVistaPrevia}" Style="{StaticResource CardBorder}" Padding="14">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Disponibilidad.AlcanzaUmbral}" Value="False">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout IsVisible="{Binding Disponibilidad.AlcanzaUmbral}" Spacing="8">
                    <Label Text="Fecha de recogida" Style="{StaticResource SectionHeading}" />
                    <Label Text="Elige hoy o una fecha posterior." Style="{StaticResource Subtitle}" />
                    <DatePicker Date="{Binding FechaProgramada, Mode=TwoWay}" Format="dd/MM/yyyy"
                                MinimumHeightRequest="48" BackgroundColor="{StaticResource EntryBackground}"
                                SemanticProperties.Description="Fecha de recogida" TextColor="{StaticResource ForestGreen}" />
                    <Button Text="Generar jornada" Command="{Binding CrearJornadaCommand}"
                            IsEnabled="{Binding PuedeInteractuar}" Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>
            </Border>
            <Button IsVisible="{Binding PuedeCancelar}" Text="Cancelar jornada"
                    Command="{Binding CancelarJornadaCommand}"
                    IsEnabled="{Binding PuedeInteractuar}" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
