<?xml version="1.0" encoding="utf-8" ?>
<ContentPage Style="{StaticResource CanvasVisual}"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ECORUTA_RAEE.Views.JornadaDetallePage"
    Title="Jornada">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <ActivityIndicator IsVisible="{Binding Ocupado}" IsRunning="{Binding Ocupado}"
                               Color="{StaticResource PrimaryGreen}" SemanticProperties.Description="Procesando jornada" />
            <Border IsVisible="{Binding HayMensaje}" Style="{StaticResource PanelVisual}" BackgroundColor="{AppThemeBinding Light={StaticResource ErrorBackground}, Dark={StaticResource NightErrorSurface}}">
                <Label Text="{Binding Mensaje}" TextColor="{AppThemeBinding Light={StaticResource ErrorColor}, Dark={StaticResource NightError}}" />
            </Border>
            <Border IsVisible="{Binding HayConfirmacion}" Style="{StaticResource PanelVisual}" BackgroundColor="{StaticResource SuccessBackground}">
                <Label Text="{Binding Confirmacion}" TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}" />
            </Border>

            <Border IsVisible="{Binding EsVistaPrevia}" Style="{StaticResource TarjetaVisual}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Vista previa" Style="{StaticResource TextoVisual}" />
                    <Label Text="{Binding Disponibilidad.Zona}" Style="{StaticResource PageTitle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Label Text="{Binding Disponibilidad.Cantidad, StringFormat='{0} solicitudes disponibles'}"
                               Style="{StaticResource TextoVisual}" />
                        <Label Grid.Column="1" Text="{Binding Disponibilidad.Peso, StringFormat='{0:0.##} kg disponibles'}"
                               Style="{StaticResource TextoVisual}" />
                    </Grid>
                    <Label Text="{Binding Disponibilidad.EstadoUmbral}" TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding TieneDetalle}" Style="{StaticResource GreenHero}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Jornada.Estado}" Value="Cancelada">
                        <Setter Property="BackgroundColor" Value="{StaticResource ForestGreen}" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Jornada.Estado}" Style="{StaticResource OnGreen}" />
                    <Label Text="{Binding Jornada.Zona}" Style="{StaticResource OnGreen}" FontSize="25" />
                    <Label Text="{Binding Jornada.FechaCreacion, StringFormat='Creada el {0:dd/MM/yyyy}'}"
                           Style="{StaticResource OnGreen}" />
                    <Label Text="{Binding Jornada.FechaProgramada, StringFormat='Programada para el {0:dd/MM/yyyy}'}"
                           Style="{StaticResource OnGreen}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Label Text="{Binding Jornada.CantidadSolicitudes, StringFormat='{0} paradas'}"
                               Style="{StaticResource OnGreen}" />
                        <Label Grid.Column="1" Text="{Binding UnidadesJornada, StringFormat='{0} unidades'}" Style="{StaticResource OnGreen}" />
                        <Label Grid.Column="2" Text="{Binding Jornada.PesoTotal, StringFormat='{0:0.##} kg estimados'}"
                               Style="{StaticResource OnGreen}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HayCoordenadasIncompletas}" Style="{StaticResource PanelVisual}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource WarningBackground}, Dark={StaticResource NightWarningSurface}}">
                <Label TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource NightAmber}}"
                       Text="{Binding CoordenadasIncompletas, StringFormat='Jornada con {0} ubicaciones incompletas. Consulta los puntos antes de la recogida en campo.'}" />
            </Border>
            <Border IsVisible="{Binding PuedePlanificar}" Style="{StaticResource TarjetaVisual}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Planificación del recorrido" Style="{StaticResource TituloVisual}" />
                    <Label Text="{Binding EstadoRuta}" Style="{StaticResource TextoVisual}" />
                    <Label IsVisible="{Binding TieneDistancia}" Text="{Binding DistanciaRecta, StringFormat='{0:0.##} km en línea recta en total'}"
                           Style="{StaticResource TituloVisual}" />
                    <Button Text="{Binding AccionRuta}" Command="{Binding PlanificarRutaCommand}"
                            IsEnabled="{Binding PuedeInteractuar}" Style="{StaticResource PrincipalVisual}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Ver ruta en el mapa" Clicked="AbrirMapa_Clicked"
                    IsVisible="{Binding TieneDetalle}" IsEnabled="{Binding PuedeInteractuar}"
                    Style="{StaticResource AccionVisual}" />

            <Label Text="{Binding ListaParadasTitulo}" Style="{StaticResource TituloVisual}" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Paradas}">
                <BindableLayout.EmptyView>
                    <Border Style="{StaticResource PanelVisual}">
                        <Label Text="Esta jornada no tiene solicitudes para mostrar." Style="{StaticResource TextoVisual}" />
                    </Border>
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TarjetaVisual}" Padding="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Style="{StaticResource PanelVisual}" Padding="8" MinimumWidthRequest="38"
                                        VerticalOptions="Start" BackgroundColor="{StaticResource PrimaryGreen}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Orden}" Value="0">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Orden}" Style="{StaticResource OnGreen}" HorizontalOptions="Center"
                                           SemanticProperties.Description="{Binding Orden, StringFormat='Parada {0}'}" />
                                </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="{Binding Solicitud.CodigoSolicitud}" Style="{StaticResource TextoVisual}" />
                                <Label Text="{Binding Solicitud.DireccionReferencia}" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                                       FontAttributes="Bold" FontSize="16" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Label Text="{Binding Solicitud.Zona}" Style="{StaticResource TextoVisual}" />
                                    <Label Grid.Column="1" Text="{Binding Solicitud.PesoTotalEstimado, StringFormat='{0:0.##} kg vigentes'}"
                                           Style="{StaticResource TextoVisual}" />
                                </Grid>
                                <Label IsVisible="{Binding TieneDistancia}"
                                       Text="{Binding DistanciaKm, StringFormat='{0:0.###} km geográficos desde la parada anterior'}"
                                       Style="{StaticResource TextoVisual}" />
                                <Label Text="Teléfono disponible" Style="{StaticResource TextoVisual}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Solicitud.TelefonoContacto}" Value="{x:Null}">
                                            <Setter Property="Text" Value="Sin teléfono registrado" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Button Text="Ver detalles" Clicked="DetalleSolicitud_Clicked" CommandParameter="{Binding Solicitud}" Style="{StaticResource AccionVisual}" />
                                <Button Text="Editar solicitud"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PuedePlanificar}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarSolicitudCommand}"
                                        CommandParameter="{Binding Solicitud}" Style="{StaticResource AccionVisual}" />
                            </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border IsVisible="{Binding EsVistaPrevia}" Style="{StaticResource TarjetaVisual}" Padding="14">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Disponibilidad.AlcanzaUmbral}" Value="False">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout IsVisible="{Binding Disponibilidad.AlcanzaUmbral}" Spacing="8">
                    <Label Text="Fecha de recogida" Style="{StaticResource TituloVisual}" />
                    <Label Text="Elige hoy o una fecha posterior." Style="{StaticResource TextoVisual}" />
                    <DatePicker Date="{Binding FechaProgramada, Mode=TwoWay}" Format="dd/MM/yyyy"
                                MinimumHeightRequest="48" BackgroundColor="{StaticResource EntryBackground}"
                                SemanticProperties.Description="Fecha de recogida" TextColor="{AppThemeBinding Light={StaticResource ForestGreen}, Dark={StaticResource NightInk}}" />
                    <Button Text="Generar jornada" Command="{Binding CrearJornadaCommand}"
                            IsEnabled="{Binding PuedeInteractuar}" Style="{StaticResource PrincipalVisual}" />
                </VerticalStackLayout>
            </Border>
            <Label IsVisible="{Binding PuedeCancelar}" Style="{StaticResource TextoVisual}"
                   Text="Cancelar libera las solicitudes. Podrán incluirse en otra jornada si cumplen los criterios." />
            <Button IsVisible="{Binding PuedeCancelar}" Text="Cancelar jornada"
                    Command="{Binding CancelarJornadaCommand}"
                    IsEnabled="{Binding PuedeInteractuar}" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
