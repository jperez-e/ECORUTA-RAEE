<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="ECORUTA_RAEE.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ECORUTA_RAEE.ViewModels"
    x:DataType="vm:LoginViewModel"
    Title="Iniciar sesión" Style="{StaticResource CanvasVisual}" NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout Padding="16,24" Spacing="16">
            <Border Style="{StaticResource GreenHero}">
                <VerticalStackLayout Spacing="8">
                    <Image Source="ui_equipo.png" WidthRequest="44" HeightRequest="44" />
                    <Label Text="EcoRuta RAEE" Style="{StaticResource OnGreen}" FontSize="28" HorizontalTextAlignment="Center" />
                    <Label Text="Gestión de residuos electrónicos" Style="{StaticResource OnGreen}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource TarjetaVisual}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Bienvenido" Style="{StaticResource TituloVisual}" />
                    <Label x:Name="AvisoInicial" Text="Configura la primera cuenta de gestión de esta instalación."
                        Style="{StaticResource TextoVisual}" IsVisible="False" />
                    <VerticalStackLayout x:Name="Campos" Spacing="8" IsVisible="False">
                        <Label Text="Correo electrónico" Style="{StaticResource TextoVisual}" />
                        <Border x:Name="BordeCorreo" StrokeShape="RoundRectangle 12" Padding="10,0">
                            <Entry x:Name="CorreoEntry" Text="{Binding Correo}" Keyboard="Email" ReturnType="Next"
                                Completed="Correo_Completed" SemanticProperties.Description="Correo electrónico" />
                        </Border>
                        <Label x:Name="ErrorCorreo" Text="{Binding ErrorCorreo}" />
                        <Label Text="Contraseña" Style="{StaticResource TextoVisual}" />
                        <Border x:Name="BordeClave" StrokeShape="RoundRectangle 12" Padding="10,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="ClaveEntry" IsPassword="True" Text="{Binding Contrasena}"
                                    ReturnType="Go" Completed="Clave_Completed" SemanticProperties.Description="Contraseña" />
                                <ImageButton x:Name="VerClave" Grid.Column="1" Source="cuenta_ojo.png" WidthRequest="48"
                                    HeightRequest="48" BackgroundColor="Transparent" Padding="13"
                                    IsVisible="{Binding TieneClave}" Clicked="Alternar_Clicked" SemanticProperties.Description="Mostrar contraseña" />
                            </Grid>
                        </Border>
                        <Label x:Name="ErrorClave" Text="{Binding ErrorClave}" />
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox IsChecked="{Binding Recordar}" SemanticProperties.Description="Recordar sesión" />
                            <Label Text="Recordar sesión" Style="{StaticResource TextoVisual}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button Text="Iniciar sesión" Command="{Binding IniciarSesionCommand}" Style="{StaticResource PrincipalVisual}" />
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" SemanticProperties.Description="Preparando acceso" />
                    <Label x:Name="Mensaje" Text="{Binding MensajeError}" />
                    <Button x:Name="Registro" Text="Registrarme" IsVisible="False" Clicked="Registro_Clicked" Style="{StaticResource AccionVisual}" />
                    <Button x:Name="Configurar" Text="Configurar cuenta gestora" IsVisible="False" Clicked="Configurar_Clicked" Style="{StaticResource PrincipalVisual}" />
                    <Button x:Name="Reintentar" Text="Reintentar" IsVisible="False" Command="{Binding ReintentarCommand}" Style="{StaticResource AccionVisual}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
