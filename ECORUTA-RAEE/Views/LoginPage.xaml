<?xml version="1.0" encoding="utf-8" ?>
    
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ECORUTA_RAEE.Views.LoginPage"
             Title="Iniciar sesión"
             BackgroundColor="#F5F7F6">
    
    <ScrollView>
        <VerticalStackLayout
            Padding="28,60"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                        Text="♻ EcoRuta RAEE"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="#176B3A"
                        HorizontalTextAlignment="Center"/>


                <Label
                    Text="Gestión inteligente de residuos electrónicos"
                FontSize="14"
                TextColor="#718078"
                HorizontalTextAlignment="Center"/>
                

                <!-- Formulario -->
            <Border
                Margin="0,20,0,0"
                Padding="22"
                BackgroundColor="White"
                Stroke="#E1E7E3"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Iniciar sesión"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#26332C" />

                    <Entry
                        x:Name="UsuarioEntry"
                        Placeholder="Usuario"
                        ClearButtonVisibility="WhileEditing"/>

                    <Entry
                        x:Name="ContrasenaEntry"
                        Placeholder="Contraseña"
                        IsPassword="True"/>

                    <Label
                        x:Name="MensajeError"
                        TextColor="#C62828"
                        FontSize="13"
                        IsVisible="False"/>

                    <!-- Botón -->
                    <Button
                        Text="INICIAR SESIÓN"
                        BackgroundColor="#1B8A4B"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="IniciarSesion_Clicked"/>

                    <Label
                      Text="Acceso de demostración"
                        FontSize="12"
                        TextColor="#718078"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>