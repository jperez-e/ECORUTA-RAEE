<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ECORUTA_RAEE.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Iniciar sesión"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="White">

    <!-- DISTRIBUCIÓN A PANTALLA COMPLETA -->
    <Grid
        RowDefinitions="0.35*,0.65*"
        RowSpacing="0">

        <!-- ZONA SUPERIOR: IDENTIDAD -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#17452F"
            Padding="24,18">

            <VerticalStackLayout
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                Spacing="11">

                <!-- LOGOTIPO -->
                <Border
                    WidthRequest="88"
                    HeightRequest="88"
                    BackgroundColor="#286347"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 26"
                    HorizontalOptions="Center">

                    <Label
                        Text="♻"
                        FontSize="54"
                        TextColor="#B7F36B"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"/>

                </Border>

                <!-- NOMBRE DE LA APLICACIÓN -->
                <Label
                    Margin="0,6,0,0"
                    Text="EcoRuta-RAEE"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"/>

                <!-- SUBTÍTULO -->
                <Label
                    Text="Gestión de residuos electrónicos"
                    FontSize="14"
                    TextColor="#D4E9D9"
                    HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </Grid>

        <!-- ZONA INFERIOR: FORMULARIO -->
        <Grid
            Grid.Row="1"
            BackgroundColor="White"
            Padding="24,22,24,20"
            RowDefinitions="*,Auto"
            RowSpacing="12">

            <!-- SCROLL PARA PANTALLAS PEQUEÑAS -->
            <ScrollView
                Grid.Row="0"
                VerticalScrollBarVisibility="Never">

                <VerticalStackLayout
                    Padding="0,12,0,12"
                    Spacing="21">

                    <!-- USUARIO -->
                    <VerticalStackLayout Spacing="9">

                        <Label
                            Text="Usuario"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#34423A"/>

                        <Border
                            Padding="15,0"
                            BackgroundColor="#F7F9F7"
                            Stroke="#DCE6DD"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 13">

                            <Entry
                                x:Name="UsuarioEntry"
                                AutomationId="LoginUsuario"
                                Placeholder="Introduce tu usuario"
                                Text="{Binding Usuario, Mode=TwoWay}"
                                TextColor="#26352B"
                                PlaceholderColor="#89958D"
                                BackgroundColor="Transparent"
                                FontSize="16"
                                HeightRequest="58"
                                HorizontalOptions="Fill"
                                ReturnType="Next"
                                Completed="UsuarioEntry_Completed"/>

                        </Border>

                    </VerticalStackLayout>

                    <!-- CONTRASEÑA -->
                    <VerticalStackLayout Spacing="9">

                        <Label
                            Text="Contraseña"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#34423A"/>

                        <Border
                            Padding="15,0"
                            BackgroundColor="#F7F9F7"
                            Stroke="#DCE6DD"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 13">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">

                                <Entry
                                    Grid.Column="0"
                                    x:Name="PasswordEntry"
                                    AutomationId="LoginContrasena"
                                    Placeholder="Introduce tu contraseña"
                                    Text="{Binding Contrasena, Mode=TwoWay}"
                                    IsPassword="True"
                                    TextColor="#26352B"
                                    PlaceholderColor="#89958D"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    HeightRequest="58"
                                    HorizontalOptions="Fill"
                                    ReturnType="Go"
                                    ReturnCommand="{Binding IniciarSesionCommand}"/>

                                <!-- MOSTRAR / OCULTAR CONTRASEÑA -->
                                <Button
                                    Grid.Column="1"
                                    x:Name="TogglePasswordButton"
                                    Text="Mostrar"
                                    Clicked="AlternarVisibilidadContrasena_Clicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#218653"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Padding="4,0"
                                    HeightRequest="48"
                                    VerticalOptions="Center"/>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>

                    <!-- ERROR DE AUTENTICACIÓN -->
                    <Border
                        Padding="13"
                        BackgroundColor="#FCEAEA"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 11"
                        IsVisible="{Binding HayError}">

                        <Label
                            Text="{Binding MensajeError}"
                            FontSize="13"
                            TextColor="#B42323"/>

                    </Border>

                    <!-- BOTÓN DE ACCESO -->
                    <Button
                        Margin="0,8,0,0"
                        Text="Iniciar sesión"
                        Command="{Binding IniciarSesionCommand}"
                        BackgroundColor="#218653"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="13"
                        HeightRequest="58"
                        HorizontalOptions="Fill"/>

                </VerticalStackLayout>

            </ScrollView>

            <!-- PIE DE PÁGINA INFERIOR -->
            <HorizontalStackLayout
                Grid.Row="1"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Spacing="8">

                <Label
                    Text="♻"
                    FontSize="17"
                    TextColor="#218653"
                    VerticalTextAlignment="Center"/>

                <Label
                    Text="Reduce · Reutiliza · Recicla"
                    FontSize="12"
                    TextColor="#718078"
                    VerticalTextAlignment="Center"/>

            </HorizontalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
