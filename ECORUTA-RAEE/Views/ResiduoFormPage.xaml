<?xml version="1.0" encoding="utf-8" ?>

<ContentPage Style="{StaticResource CanvasVisual}"
    x:Class="ECORUTA_RAEE.Views.ResiduoFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding TituloFormulario}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource NightCanvas}}">

    <ScrollView>

        <VerticalStackLayout
            Padding="22,24,22,35"
            Spacing="18">

            <!-- ENCABEZADO -->
            <Label
                Text="REGISTRO DE EQUIPOS"
                FontSize="11"
                FontAttributes="Bold"
                CharacterSpacing="1.5"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}"/>

            <Label
                Text="{Binding TituloFormulario}"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

            <Label
                Text="Completa la información del residuo electrónico."
                FontSize="13"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"/>

            <!-- FORMULARIO -->
            <Border
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource NightSurface}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource NightBorder}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="17">

                    <!-- SOLICITUD -->
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Solicitud de recogida *"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                        <Picker
                            Title="Selecciona una solicitud"
                            ItemsSource="{Binding SolicitudesDisponibles}"
                            ItemDisplayBinding="{Binding CodigoSolicitud}"
                            SelectedItem="{Binding SolicitudSeleccionada, Mode=TwoWay}"
                            BackgroundColor="#F4F8F4"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                            HeightRequest="50"/>

                        <Label
                            Text="{Binding ErrorSolicitud}"
                            IsVisible="{Binding TieneErrorSolicitud}"
                            FontSize="12"
                            TextColor="#B42323"/>

                    </VerticalStackLayout>

                    <!-- CATEGORÍA -->
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Categoría del equipo *"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                        <Picker
                            Title="Selecciona una categoría"
                            ItemsSource="{Binding Categorias}"
                            SelectedItem="{Binding Categoria, Mode=TwoWay}"
                            BackgroundColor="#F4F8F4"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                            HeightRequest="50"/>

                        <Label
                            Text="{Binding ErrorCategoria}"
                            IsVisible="{Binding TieneErrorCategoria}"
                            FontSize="12"
                            TextColor="#B42323"/>

                    </VerticalStackLayout>

                    <!-- DESCRIPCIÓN -->
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Descripción del equipo *"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                        <Border
                            Padding="12,5"
                            BackgroundColor="#F4F8F4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">

                            <Editor
                                Text="{Binding Descripcion, Mode=TwoWay}"
                                Placeholder="Ej.: Monitor Samsung de 24 pulgadas"
                                PlaceholderColor="#89958D"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="85"
                                MaxLength="150"/>

                        </Border>

                        <Label
                            Text="{Binding ErrorDescripcion}"
                            IsVisible="{Binding TieneErrorDescripcion}"
                            FontSize="12"
                            TextColor="#B42323"/>

                    </VerticalStackLayout>

                    <!-- CANTIDAD -->
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Cantidad de equipos *"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                        <Border
                            Padding="12,0"
                            BackgroundColor="#F4F8F4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">

                            <Entry
                                Text="{Binding CantidadTexto, Mode=TwoWay}"
                                Placeholder="Ej.: 2"
                                Keyboard="Numeric"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                                BackgroundColor="Transparent"
                                HeightRequest="50"/>

                        </Border>

                        <Label
                            Text="{Binding ErrorCantidad}"
                            IsVisible="{Binding TieneErrorCantidad}"
                            FontSize="12"
                            TextColor="#B42323"/>

                    </VerticalStackLayout>

                    <!-- PESO -->
                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="Peso estimado total (kg) *"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                        <Border
                            Padding="12,0"
                            BackgroundColor="#F4F8F4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">

                            <Entry
                                Text="{Binding PesoTexto, Mode=TwoWay}"
                                Placeholder="Ej.: 5.5"
                                Keyboard="Numeric"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                                BackgroundColor="Transparent"
                                HeightRequest="50"/>

                        </Border>

                        <Label
                            Text="Indica el peso total de los equipos de esta categoría."
                            FontSize="11"
                            TextColor="#89958D"/>

                        <Label
                            Text="{Binding ErrorPeso}"
                            IsVisible="{Binding TieneErrorPeso}"
                            FontSize="12"
                            TextColor="#B42323"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- BOTONES -->
            <Button
                Text="{Binding TextoBotonGuardar}"
                Command="{Binding GuardarCommand}"
                BackgroundColor="#218653"
                TextColor="White"
                FontSize="15"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="52"/>

            <Button
                Text="Eliminar residuo"
                Command="{Binding EliminarCommand}"
                IsVisible="{Binding MostrarBotonEliminar}"
                BackgroundColor="#FCE4E4"
                TextColor="#B42323"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="48"/>

            <Button
                Text="Cancelar"
                Command="{Binding CancelarCommand}"
                BackgroundColor="#E4EAE5"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="48"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>