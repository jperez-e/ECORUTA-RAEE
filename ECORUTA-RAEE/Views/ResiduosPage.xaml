<?xml version="1.0" encoding="utf-8" ?>

<ContentPage Style="{StaticResource CanvasVisual}"
    x:Class="ECORUTA_RAEE.Views.ResiduosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Residuos electrónicos"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource NightCanvas}}">

    <Grid RowDefinitions="Auto,*">

        <!-- ENCABEZADO COMPACTO -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="18,16,18,12"
            Spacing="11">

            <Label
                Text="GESTIÓN DE RESIDUOS"
                FontSize="10"
                FontAttributes="Bold"
                CharacterSpacing="1.2"
                TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}"/>

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="Residuos electrónicos"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                    <Label
                        Text="Administra los equipos registrados"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"/>

                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#DFF2E3"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 13">

                    <Image Source="ui_equipo.png" WidthRequest="28" HeightRequest="28" />

                </Border>

            </Grid>

            <!-- CONTADOR -->
            <Border
                Padding="14,11"
                BackgroundColor="#17452F"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 15">

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        Spacing="3">

                        <Label
                            Text="RESIDUOS REGISTRADOS"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#D4E9D9"/>

                        <Label
                            Text="Equipos de tus solicitudes"
                            FontSize="12"
                            TextColor="White"/>

                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        Padding="13,6"
                        BackgroundColor="#B7F36B"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 11"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding TotalResiduos}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                    </Border>

                </Grid>

            </Border>

            <!-- CREAR -->
            <Button
                Text="+  Nuevo residuo"
                Command="{Binding NuevoResiduoCommand}"
                BackgroundColor="#218653"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="46"/>

            <!-- BUSCADOR -->
            <SearchBar
                Placeholder="Buscar equipo, categoría o solicitud"
                SemanticProperties.Description="Buscar registros de equipos"
                Text="{Binding TextoBusqueda, Mode=TwoWay}"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource NightSurface}}"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"
                FontSize="13"
                HeightRequest="46"/>

            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Text="LISTADO DE EQUIPOS"
                    FontSize="10"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"
                    VerticalTextAlignment="Center"/>

                <Label
                    Grid.Column="1"
                    Text="{Binding ResumenBusqueda}"
                    IsVisible="{Binding HayBusqueda}"
                    FontSize="11"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}"
                    VerticalTextAlignment="Center"/>

            </Grid>

        </VerticalStackLayout>

        <!-- LISTADO -->
        <CollectionView
            Grid.Row="1"
            Margin="18,0,18,10"
            ItemsSource="{Binding Residuos}"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="24"
                    Spacing="10"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Image Source="ui_equipo.png" WidthRequest="28" HeightRequest="28" />

                    <Label
                        Text="{Binding TituloListaVacia}"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="{Binding DescripcionListaVacia}"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"
                        HorizontalTextAlignment="Center"
                        MaximumWidthRequest="290"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <!-- TARJETA COMPACTA -->
                    <Border
                        Margin="0,0,0,11"
                        Padding="14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource NightSurface}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource NightBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="11">

                            <!-- ÁREA QUE ABRE EDICIÓN -->
                            <Grid
                                ColumnDefinitions="48,*"
                                ColumnSpacing="11">

                                <Grid.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}"
                                        CommandParameter="{Binding .}"/>

                                </Grid.GestureRecognizers>

                                <!-- ICONO -->
                                <Border
                                    Grid.Column="0"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    BackgroundColor="#E4F2E6"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 13"
                                    VerticalOptions="Start">

                                    <Label
                                        Text="▣"
                                        FontSize="27"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"/>

                                </Border>

                                <!-- DATOS DEL EQUIPO -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4">

                                    <Label
                                        Text="{Binding Categoria}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}"/>

                                    <Label
                                        Text="{Binding Descripcion}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                                        LineBreakMode="WordWrap"/>

                                    <Label
                                        Text="{Binding SolicitudId, StringFormat='Solicitud #{0}'}"
                                        FontSize="11"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"/>

                                </VerticalStackLayout>

                            </Grid>

                            <!-- CANTIDAD Y PESO -->
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">

                                <!-- CANTIDAD -->
                                <Border
                                    Grid.Column="0"
                                    Padding="11,9"
                                    BackgroundColor="#F4F8F4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 11">

                                    <VerticalStackLayout Spacing="4">

                                        <Label
                                            Text="CANTIDAD"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            TextColor="#89958D"/>

                                        <HorizontalStackLayout Spacing="4">

                                            <Label
                                                Text="{Binding Cantidad}"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                                            <Label
                                                Text="unidades"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"
                                                VerticalTextAlignment="Center"/>

                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>

                                </Border>

                                <!-- PESO -->
                                <Border
                                    Grid.Column="1"
                                    Padding="11,9"
                                    BackgroundColor="#F4F8F4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 11">

                                    <VerticalStackLayout Spacing="4">

                                        <Label
                                            Text="PESO ESTIMADO"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            TextColor="#89958D"/>

                                        <Label
                                            Text="{Binding PesoEstimado, StringFormat='{0:F2} kg'}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>

                            <!-- ACCIONES -->
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">

                                <Button
                                    Grid.Column="0"
                                    Text="Editar equipo"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#E4F2E6"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    Padding="8,0"/>

                                <Button
                                    Grid.Column="1"
                                    Text="Eliminar"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#FCE4E4"
                                    TextColor="#B42323"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    Padding="8,0"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>