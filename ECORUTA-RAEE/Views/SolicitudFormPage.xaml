<?xml version="1.0" encoding="utf-8" ?>

<ContentPage Style="{StaticResource CanvasVisual}"
    x:Class="ECORUTA_RAEE.Views.SolicitudFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ECORUTA_RAEE.ViewModels"
    Title="{Binding TituloFormulario}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource NightCanvas}}">

    <ContentPage.Resources>
        <Style x:Key="ErrorEquipo" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource ErrorColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger TargetType="Label" Property="Text" Value="">
                    <Setter Property="IsVisible" Value="False"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            IsEnabled="{Binding PuedeEditarFormulario}"
            Padding="22,20,22,30"
            Spacing="22">

            <Label Text="Modo demostración · Datos de este dispositivo" Style="{StaticResource TextoVisual}" />
            <!-- Encabezado -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">

                <VerticalStackLayout Spacing="7">
                    <Label
                        Text="GESTIÓN AMBIENTAL"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}"/>

                    <Label
                        Text="{Binding TituloFormulario}"
                        FontSize="29"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                    <Label
                        Text="Organicemos juntos la recogida de tus electrónicos."
                        FontSize="14"
                        LineHeight="1.3"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"/>
                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="54"
                    HeightRequest="54"
                    Padding="0"
                    BackgroundColor="#DFF2E3"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 17"
                    VerticalOptions="Start">

                    <Image Source="ui_equipo.png" WidthRequest="28" HeightRequest="28" />
                </Border>
            </Grid>

            <!-- Indicador de progreso -->
            <Border
                Padding="16,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource NightSurface}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource NightBorder}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">

                    <Border
                        WidthRequest="38"
                        HeightRequest="38"
                        BackgroundColor="#218653"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">

                        <Label
                            Text="1"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="3">

                        <Label
                            Text="Información de recogida"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                        <Label
                            Text="Completa los datos para registrar tu solicitud."
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource TarjetaVisual}">
                <VerticalStackLayout Spacing="7">
                    <Label Text="Datos de contacto" Style="{StaticResource TituloVisual}" />
                    <Label Text="¿Con quién podemos comunicarnos?" Style="{StaticResource TextoVisual}" />
                    <Label Text="Nombre de contacto (opcional)" Style="{StaticResource TextoVisual}" />
                    <Entry Text="{Binding NombreContacto}" MaxLength="100"
                           Style="{StaticResource CampoVisual}" SemanticProperties.Description="Nombre de contacto" />
                    <Label Text="{Binding ErrorNombreContacto}" Style="{StaticResource ErrorEquipo}" />
                    <Label Text="Número de teléfono (opcional)" Style="{StaticResource TextoVisual}" />
                    <Picker ItemsSource="{Binding PrefijosContacto}" SelectedItem="{Binding PrefijoContacto}"
                            Title="Prefijo internacional" SemanticProperties.Description="Prefijo internacional" />
                    <Entry Text="{Binding TelefonoContacto}" Keyboard="Telephone" MaxLength="32"
                           Style="{StaticResource CampoVisual}" SemanticProperties.Description="Número de teléfono" />
                    <Label Text="{Binding ErrorTelefonoContacto}" Style="{StaticResource ErrorEquipo}" />
                    <Label Text="El teléfono ayuda a coordinar la recogida. En modo demostración, el contacto se guarda en este dispositivo y los perfiles Gestor y Recolector pueden consultarlo."
                           Style="{StaticResource TextoVisual}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Ubicación de recogida -->
            <Border
                Style="{StaticResource TarjetaVisual}"
                Padding="16,12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ubicación de recogida" Style="{StaticResource TituloVisual}"/>
                    <Label Text="{Binding EstadoUbicacion}" Style="{StaticResource TextoVisual}"/>
                    <Button Text="{Binding TextoBotonMapa}" Clicked="AbrirMapa_Clicked"
                            IsEnabled="{Binding FormularioDisponible}" Style="{StaticResource AccionVisual}"/>
                    <Button Text="Quitar ubicación" Command="{Binding QuitarUbicacionCommand}"
                            IsVisible="{Binding TieneUbicacion}" Style="{StaticResource AccionVisual}"/>
                    <VerticalStackLayout IsVisible="{Binding PermitirCoordenadasAvanzadas}" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Coordenadas avanzadas (opcional)" VerticalOptions="Center"
                               Style="{StaticResource TextoVisual}"/>
                        <Switch Grid.Column="1" IsToggled="{Binding MostrarCoordenadasAvanzadas, Mode=TwoWay}"
                                OnColor="{StaticResource AccentGreen}"
                                SemanticProperties.Description="Mostrar coordenadas avanzadas"/>
                    </Grid>
                    <Grid IsVisible="{Binding MostrarCoordenadasAvanzadas}" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Latitud" Style="{StaticResource TextoVisual}"/>
                            <Entry Text="{Binding LatitudTexto, Mode=TwoWay}" Placeholder="-90 a 90"
                                   IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"
                                   Style="{StaticResource CampoVisual}"
                                   SemanticProperties.Description="Latitud en grados decimales"/>
                            <Label Text="{Binding ErrorLatitud}" IsVisible="{Binding TieneErrorLatitud}"
                                   TextColor="{AppThemeBinding Light={StaticResource ErrorColor}, Dark={StaticResource NightError}}" FontSize="12"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Longitud" Style="{StaticResource TextoVisual}"/>
                            <Entry Text="{Binding LongitudTexto, Mode=TwoWay}" Placeholder="-180 a 180"
                                   IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"
                                   Style="{StaticResource CampoVisual}"
                                   SemanticProperties.Description="Longitud en grados decimales"/>
                            <Label Text="{Binding ErrorLongitud}" IsVisible="{Binding TieneErrorLongitud}"
                                   TextColor="{AppThemeBinding Light={StaticResource ErrorColor}, Dark={StaticResource NightError}}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Confirmación y referencia -->
            <Border
                Padding="19"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource NightSurface}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource NightBorder}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="01  ·  UBICACIÓN"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}"/>

                    <Label
                        Text="Confirma la zona de recogida"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                    <Label
                        Text="Indica la zona del punto elegido y agrega una referencia para encontrarlo."
                        FontSize="13"
                        LineHeight="1.3"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"/>

                    <!-- Zona -->
                    <Label
                        Margin="0,8,0,0"
                        Text="Zona de recogida *"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                    <Border
                        Padding="12,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryBackground}, Dark={StaticResource NightRaised}}"
                        Stroke="#DCE6DD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                        <Picker
                            Title="Selecciona una zona"
                            ItemsSource="{Binding Zonas}"
                            SelectedItem="{Binding ZonaSeleccionada}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                            TitleColor="#89958D"
                            BackgroundColor="Transparent"
                            HeightRequest="52"/>
                    </Border>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding EsOtraZona}">
                        <Label Text="Sector o comunidad *" Style="{StaticResource TextoVisual}"/>
                        <Entry Text="{Binding SectorOtraZona}" Placeholder="Nombre del sector o comunidad"
                               MaxLength="100" Style="{StaticResource CampoVisual}"/>
                    </VerticalStackLayout>

                    <Label Text="{Binding EstadoZona}" Style="{StaticResource TextoVisual}"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding ZonaConfirmada, Mode=TwoWay}"
                                  IsEnabled="{Binding PuedeConfirmarZona}"
                                  Color="{StaticResource AccentGreen}"
                                  SemanticProperties.Description="Confirmo que la zona corresponde al lugar de recogida"/>
                        <Label Grid.Column="1" VerticalOptions="Center"
                               Text="Confirmo que la zona corresponde al lugar de recogida."
                               Style="{StaticResource TextoVisual}"/>
                    </Grid>

                    <Label
                        Text="{Binding ErrorZona}"
                        IsVisible="{Binding TieneErrorZona}"
                        TextColor="#C62828"
                        FontSize="12"/>

                    <!-- Dirección -->
                    <Label
                        Margin="0,8,0,0"
                        Text="Dirección de referencia *"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"/>

                    <Border
                        Padding="12,8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryBackground}, Dark={StaticResource NightRaised}}"
                        Stroke="#DCE6DD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                        <Editor
                            Placeholder="Ej. Calle principal, edificio, sector o punto cercano"
                            Text="{Binding DireccionReferencia}"
                            AutoSize="TextChanges"
                            HeightRequest="100"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                            PlaceholderColor="#89958D"
                            BackgroundColor="Transparent"/>
                    </Border>

                    <Label
                        Text="{Binding ErrorDireccion}"
                        IsVisible="{Binding TieneErrorDireccion}"
                        TextColor="#C62828"
                        FontSize="12"/>

                    <Label
                        Text="Evita incluir información personal que no sea necesaria para localizar el punto."
                        FontSize="11"
                        LineHeight="1.3"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource TarjetaVisual}" Padding="16,12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="02 · Equipos electrónicos" Style="{StaticResource TituloVisual}"/>
                    <Label Text="Agrega un registro por tipo de equipo."
                           IsVisible="{Binding SinEquipos}" Style="{StaticResource TextoVisual}"/>
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Equipos}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:EquipoBorradorViewModel">
                                <Border Style="{StaticResource TarjetaVisual}" Padding="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding Titulo}" Style="{StaticResource TituloVisual}"/>
                                        <Label Text="{Binding Resumen}" Style="{StaticResource TextoVisual}"/>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Text="{Binding TextoEditor}" Command="{Binding AlternarEditorCommand}"
                                                    Style="{StaticResource AccionVisual}"/>
                                            <Button Grid.Column="1" Text="Quitar" Command="{Binding QuitarCommand}"
                                                    Style="{StaticResource AccionVisual}"/>
                                        </Grid>
                                        <VerticalStackLayout Spacing="5" IsVisible="{Binding MostrandoEditor}">
                                            <Label Text="Categoría *" Style="{StaticResource TextoVisual}"/>
                                            <Picker Title="Selecciona una categoría" ItemsSource="{Binding Categorias}"
                                                    SelectedItem="{Binding Categoria, Mode=TwoWay}"
                                                    SemanticProperties.Description="Categoría del equipo"/>
                                            <Label Text="{Binding ErrorCategoria}" Style="{StaticResource ErrorEquipo}"/>
                                            <Label Text="Descripción *" Style="{StaticResource TextoVisual}"/>
                                            <Entry Text="{Binding Descripcion}" Placeholder="Ej. Televisor LCD"
                                                   Style="{StaticResource CampoVisual}"/>
                                            <Label Text="{Binding ErrorDescripcion}" Style="{StaticResource ErrorEquipo}"/>
                                            <Label Text="Cantidad de equipos *" Style="{StaticResource TextoVisual}"/>
                                            <Entry Text="{Binding CantidadTexto}" Keyboard="Numeric"
                                                   SemanticProperties.Description="Cantidad de equipos"
                                                   Style="{StaticResource CampoVisual}"/>
                                            <Label Text="{Binding ErrorCantidad}" Style="{StaticResource ErrorEquipo}"/>
                                            <Label Text="Peso total estimado de estos equipos (kg) *"
                                                   Style="{StaticResource TextoVisual}"/>
                                            <Entry Text="{Binding PesoTexto}" Keyboard="Numeric" Placeholder="Ej. 8,5"
                                                   SemanticProperties.Description="Peso total del registro en kilogramos"
                                                   Style="{StaticResource CampoVisual}"/>
                                            <Label Text="{Binding ErrorPeso}" Style="{StaticResource ErrorEquipo}"/>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Agregar equipo" Command="{Binding AgregarEquipoCommand}"
                            Style="{StaticResource AccionVisual}"/>
                    <Label Text="{Binding ErrorEquipos}" Style="{StaticResource ErrorEquipo}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Mensaje de éxito -->
            <Border
                Padding="13"
                BackgroundColor="#E5F5E8"
                Stroke="#B7E2C0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                IsVisible="{Binding GuardadoExitoso}">

                <Label
                    Text="{Binding MensajeExito}"
                    FontSize="13"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}"/>
            </Border>

            <Border
                Padding="16,10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource NightSurface}}"
                Stroke="#E3ECE5"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label
                            Text="Personalizar código"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                            FontSize="14"
                            VerticalOptions="Center"/>
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding PersonalizarCodigo, Mode=TwoWay}"
                            OnColor="#218653"
                            SemanticProperties.Description="Personalizar código"/>
                    </Grid>

                    <VerticalStackLayout
                        Spacing="4"
                        IsVisible="{Binding PersonalizarCodigo}">
                        <Entry
                            Text="{Binding CodigoTexto, Mode=TwoWay}"
                            Placeholder="SOL-0001"
                            SemanticProperties.Description="Código de solicitud"
                            Style="{StaticResource CampoVisual}"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"/>
                        <Label
                            Text="{Binding ErrorCodigo}"
                            IsVisible="{Binding TieneErrorCodigo}"
                            TextColor="{AppThemeBinding Light={StaticResource ErrorColor}, Dark={StaticResource NightError}}"
                            FontSize="12"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource TarjetaVisual}" Padding="16,12">
                <VerticalStackLayout Spacing="7">
                    <Label Text="03 · Resumen" Style="{StaticResource TituloVisual}"/>
                    <Label Text="{Binding RegistrosEquipos, StringFormat='Registros de equipos: {0}'}"
                           Style="{StaticResource TextoVisual}"/>
                    <Label Text="{Binding UnidadesEquipos, StringFormat='Unidades físicas: {0}'}"
                           Style="{StaticResource TextoVisual}"/>
                    <Label Text="{Binding ZonaResumen, StringFormat='Zona: {0}'}"
                           Style="{StaticResource TextoVisual}"/>
                    <Label Text="{Binding ResumenContacto}" Style="{StaticResource TextoVisual}" />
                    <Label Text="{Binding PesoResumen, StringFormat='Peso total estimado: {0:F2} kg'}"
                           Style="{StaticResource TituloVisual}"/>
                    <VerticalStackLayout IsVisible="{Binding PesoEditable}" Spacing="5">
                        <Label Text="Peso manual de la solicitud sin equipos (kg)"
                               Style="{StaticResource TextoVisual}"/>
                        <Entry Text="{Binding PesoTexto, Mode=TwoWay}" Keyboard="Numeric"
                               Style="{StaticResource CampoVisual}"/>
                        <Label Text="{Binding ErrorPeso}" Style="{StaticResource ErrorEquipo}"/>
                    </VerticalStackLayout>
                    <Button Text="{Binding TextoBotonGuardar}" Command="{Binding GuardarCommand}"
                            Style="{StaticResource PrincipalVisual}"/>
                    <ActivityIndicator IsRunning="{Binding Guardando}" IsVisible="{Binding Guardando}"
                                       Color="{StaticResource AccentGreen}"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="11">



                <Button
    Text="Eliminar solicitud"
    Command="{Binding EliminarCommand}"
    IsVisible="{Binding MostrarBotonEliminar}"
    BackgroundColor="#FCE4E4"
    TextColor="#B42323"
    FontSize="14"
    FontAttributes="Bold"
    CornerRadius="12"
    HeightRequest="46"
    BorderColor="#F3C5C5"
    BorderWidth="1"/>

                <Button
                    Text="Cancelar"
                    Command="{Binding CancelarCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"
                    FontSize="14"
                    CornerRadius="12"
                    HeightRequest="46"
                    BorderColor="#DCE6DD"
                    BorderWidth="1"/>
            </VerticalStackLayout>

            <!-- Nota ambiental -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="7">

                <Image Source="ui_listo.png" WidthRequest="28" HeightRequest="28" />

                <Label
                    Text="Cada dispositivo bien gestionado cuenta."
                    FontSize="12"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}"
                    VerticalTextAlignment="Center"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
