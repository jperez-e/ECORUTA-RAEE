<?xml version="1.0" encoding="utf-8" ?>
    
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ECORUTA_RAEE.Views.SolicitudFormPage"
             Title="Nueva solicitud"
             BackgroundColor="#F5F7F6">

    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="16">

            <Label
                Text="Nueva solicitud"
                FontSize="27"
                FontAttributes="Bold"
                TextColor="#176B3A"/>

            <Label
                Text="Registra dónde se encuentran los residuos electrónicos."
                FontSize="14"
                TextColor="#718078"/>

            <Border
                Padding="18"
                BackgroundColor="White"
                Stroke="#E1E7E3"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Zona"
                        FontAttributes="Bold"
                        TextColor="#34423A"/>

                    <Picker
                        x:Name="ZonaPicker"
                        Title="Selecciona una zona"
                        ItemsSource="{Binding Zonas}"/>

                    <Label
                        Text="Dirección o referencia"
                        FontAttributes="Bold"
                        TextColor="#34423A"/>

                    <Editor
                        x:Name="DireccionEditor"
                        Placeholder="Ej. Calle, sector o punto de referencia"
                        AutoSize="TextChanges"
                        HeightRequest="90"/>

                    <Label
                        Text="Peso total estimado (kg)"
                        FontAttributes="Bold"
                        TextColor="#34423A"/>

                    <Entry
                        x:Name="PesoEntry"
                        Placeholder="Ej. 12.5"
                        Keyboard="Numeric"/>

                    <Label
                        x:Name="MensajeError"
                        TextColor="#C62828"
                        FontSize="13"
                        IsVisible="False"/>

                    <Button
                        Text="GUARDAR SOLICITUD"
                        BackgroundColor="#1B8A4B"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="Guardar_Clicked"/>

                    <Button
                        Text="CANCELAR"
                        BackgroundColor="#E7ECE8"
                        TextColor="#34423A"
                        CornerRadius="12"
                        Clicked="Cancelar_Clicked"/>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>