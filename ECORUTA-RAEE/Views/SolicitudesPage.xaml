<?xml version="1.0" encoding="utf-8" ?>
    
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ECORUTA_RAEE.Views.SolicitudesPage"
             Title="Solicitudes"
             BackgroundColor="#F5F7F6">

    <Grid
        RowDefinitions="Auto,Auto,*"
        Padding="20">

        <Label
            Grid.Row="0"
            Text="Solicitudes de recolección"
            FontSize="24"
            FontAttributes="Bold"
            TextColor="#176B3A"/>

        <Button
            Grid.Row="1"
            Margin="0,12,0,12"
            Text="+ Nueva solicitud"
            BackgroundColor="#1B8A4B"
            TextColor="White"
            Clicked="NuevaSolicitud_Clicked"/>

        <CollectionView
            x:Name="SolicitudesCollection"
            Grid.Row="2"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="20"
                    Spacing="8"
                    VerticalOptions="Center">

                    <Label
                        Text="Todavía no hay solicitudes."
                        FontSize="16"
                        TextColor="#718078"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Crea la primera para comenzar."
                        FontSize="13"
                        TextColor="#718078"
                        HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,12"
                        Padding="16"
                        BackgroundColor="White"
                        Stroke="#E1E7E3"
                        StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout Spacing="7">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding CodigoSolicitud}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#176B3A"/>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Estado}"
                                    FontSize="12"
                                    TextColor="#8A6A1B"
                                    VerticalOptions="Center"/>
                            </Grid>

                            <Label
                                Text="{Binding Zona, StringFormat='Zona: {0}'}"
                                FontSize="14"
                                TextColor="#34423A"/>

                            <Label
                                Text="{Binding DireccionReferencia, StringFormat='Dirección: {0}'}"
                                FontSize="13"
                                TextColor="#718078"/>

                            <Label
                                Text="{Binding PesoTotalEstimado, StringFormat='Peso estimado: {0:F2} kg'}"
                                FontSize="13"
                                TextColor="#718078"/>

                            <Label
                                Text="{Binding FechaRegistro, StringFormat='Registrada: {0:dd/MM/yyyy HH:mm}'}"
                                FontSize="12"
                                TextColor="#9AA69F"/>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
        