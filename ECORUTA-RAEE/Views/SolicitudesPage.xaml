<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ECORUTA_RAEE.Views.SolicitudesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Solicitudes"
    BackgroundColor="#F4F7F4">

    <Grid RowDefinitions="Auto,*">

        <!-- ENCABEZADO COMPACTO -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="18,16,18,12"
            Spacing="11">

            <Label
                Text="GESTIÓN DE RECOLECCIÓN"
                FontSize="10"
                FontAttributes="Bold"
                CharacterSpacing="1.2"
                TextColor="#218653"/>

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="Mis solicitudes"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="#183D2B"/>

                    <Label
                        Text="Consulta y administra tus recogidas"
                        FontSize="12"
                        TextColor="#718078"/>

                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#DFF2E3"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 13">

                    <Label
                        Text="♻"
                        FontSize="25"
                        TextColor="#218653"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"/>

                </Border>

            </Grid>

            <!-- CONTADOR -->
            <Border
                Padding="14,11"
                BackgroundColor="#17452F"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 15">

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        Spacing="3">

                        <Label
                            Text="SOLICITUDES REGISTRADAS"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#D4E9D9"/>

                        <Label
                            Text="Historial de recolecciones"
                            FontSize="12"
                            TextColor="White"/>

                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        Padding="13,6"
                        BackgroundColor="#B7F36B"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 11"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding TotalSolicitudes}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#183D2B"/>

                    </Border>

                </Grid>

            </Border>

            <!-- CREAR -->
            <Button
                Text="+  Nueva solicitud"
                Command="{Binding NuevaSolicitudCommand}"
                BackgroundColor="#218653"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="46"/>

            <!-- BUSCADOR -->
            <SearchBar
                Placeholder="Buscar código, zona o dirección"
                Text="{Binding TextoBusqueda, Mode=TwoWay}"
                BackgroundColor="White"
                TextColor="#26352B"
                PlaceholderColor="#718078"
                FontSize="13"
                HeightRequest="46"/>

            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Text="HISTORIAL DE SOLICITUDES"
                    FontSize="10"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#718078"
                    VerticalTextAlignment="Center"/>

                <Label
                    Grid.Column="1"
                    Text="{Binding ResumenBusqueda}"
                    IsVisible="{Binding HayBusqueda}"
                    FontSize="11"
                    TextColor="#218653"
                    VerticalTextAlignment="Center"/>

            </Grid>

        </VerticalStackLayout>

        <!-- LISTADO -->
        <CollectionView
            Grid.Row="1"
            Margin="18,0,18,10"
            ItemsSource="{Binding Solicitudes}"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="24"
                    Spacing="10"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="♻"
                        FontSize="45"
                        TextColor="#218653"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="{Binding TituloListaVacia}"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#26352B"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="{Binding DescripcionListaVacia}"
                        FontSize="12"
                        TextColor="#718078"
                        HorizontalTextAlignment="Center"
                        MaximumWidthRequest="290"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <!-- TARJETA COMPACTA -->
                    <Border
                        Margin="0,0,0,11"
                        Padding="14"
                        BackgroundColor="White"
                        Stroke="#E1E9E2"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="11">

                            <!-- ÁREA QUE ABRE EDICIÓN -->
                            <VerticalStackLayout Spacing="10">

                                <VerticalStackLayout.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}"
                                        CommandParameter="{Binding .}"/>

                                </VerticalStackLayout.GestureRecognizers>

                                <!-- CÓDIGO Y ESTADO -->
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8">

                                    <VerticalStackLayout Spacing="3">

                                        <Label
                                            Text="SOLICITUD DE RECOLECCIÓN"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            CharacterSpacing="0.6"
                                            TextColor="#89958D"/>

                                        <Label
                                            Text="{Binding CodigoSolicitud}"
                                            FontSize="19"
                                            FontAttributes="Bold"
                                            TextColor="#218653"/>

                                    </VerticalStackLayout>

                                    <!-- INDICADOR DE ESTADO -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="9,5"
                                        BackgroundColor="#FFF1D2"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 9"
                                        VerticalOptions="Center">

                                        <Border.Triggers>

                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Estado}"
                                                Value="En proceso">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="#DDEBFF"/>
                                            </DataTrigger>

                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Estado}"
                                                Value="Completada">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="#DDF4E2"/>
                                            </DataTrigger>

                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding Estado}"
                                                Value="Cancelada">
                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="#FCE4E4"/>
                                            </DataTrigger>

                                        </Border.Triggers>

                                        <Label
                                            Text="{Binding Estado}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="#8A6415">

                                            <Label.Triggers>

                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Estado}"
                                                    Value="En proceso">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="#245DA8"/>
                                                </DataTrigger>

                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Estado}"
                                                    Value="Completada">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="#176B3A"/>
                                                </DataTrigger>

                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Estado}"
                                                    Value="Cancelada">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="#B42323"/>
                                                </DataTrigger>

                                            </Label.Triggers>

                                        </Label>

                                    </Border>

                                </Grid>

                                <BoxView
                                    HeightRequest="1"
                                    Color="#EDF1ED"/>

                                <!-- ZONA Y DIRECCIÓN AGRUPADAS -->
                                <Grid
                                    ColumnDefinitions="22,*"
                                    ColumnSpacing="8">

                                    <Label
                                        Text="⌖"
                                        FontSize="22"
                                        TextColor="#218653"
                                        VerticalTextAlignment="Start"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3">

                                        <Label
                                            Text="{Binding Zona}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="#26352B"/>

                                        <Label
                                            Text="{Binding DireccionReferencia}"
                                            FontSize="12"
                                            TextColor="#718078"
                                            LineBreakMode="WordWrap"/>
                                        <Label Text="{Binding DisponibilidadOperativa}" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryGreen}" />

                                    </VerticalStackLayout>

                                </Grid>

                                <!-- PESO Y FECHA EN UNA SOLA FILA -->
                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="8">

                                    <HorizontalStackLayout
                                        Spacing="6"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="⚖"
                                            FontSize="15"
                                            TextColor="#218653"/>

                                        <Label
                                            Text="{Binding PesoTotalEstimado, StringFormat='{0:F2} kg'}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="#218653"/>

                                    </HorizontalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding FechaRegistro, StringFormat='{0:dd/MM/yyyy · hh:mm tt}'}"
                                        FontSize="11"
                                        TextColor="#718078"
                                        HorizontalTextAlignment="End"
                                        VerticalTextAlignment="Center"/>

                                </Grid>

                            </VerticalStackLayout>

                            <!-- ACCIONES -->
                            <Grid
                                ColumnDefinitions="*,1.3*,*"
                                ColumnSpacing="6">

                                <Button
                                    Grid.Column="0"
                                    Text="Editar"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#E4F2E6"
                                    TextColor="#176B3A"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    Padding="5,0"/>

                                <Button
                                    Grid.Column="1"
                                    Text="Ver equipos"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerResiduosCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#E4F2E6"
                                    TextColor="#176B3A"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    Padding="4,0"/>

                                <Button
                                    Grid.Column="2"
                                    Text="Eliminar"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#FCE4E4"
                                    TextColor="#B42323"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    Padding="4,0"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
