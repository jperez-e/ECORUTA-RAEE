<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ECORUTA_RAEE.Models"
             xmlns:vm="clr-namespace:ECORUTA_RAEE.ViewModels"
             x:Class="ECORUTA_RAEE.Views.SolicitudesPage" x:DataType="vm:SolicitudesViewModel"
             Title="Solicitudes" Style="{StaticResource CanvasVisual}">
    <Grid RowDefinitions="Auto,*" Padding="16,8,16,0" RowSpacing="8">
        <VerticalStackLayout Spacing="8">
            <Border Style="{StaticResource CabeceraVisual}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Gestión de solicitudes" Style="{StaticResource OnGreen}" FontSize="23" />
                    <Label Text="Consulta, organiza y administra los registros." Style="{StaticResource OnGreen}" FontSize="13" />
                </VerticalStackLayout>
            </Border>
            <SearchBar Placeholder="Buscar código, zona o dirección" Text="{Binding TextoBusqueda, Mode=TwoWay}"
                       MinimumHeightRequest="48" SemanticProperties.Description="Buscar solicitudes"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource NightSurface}}"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource NightMuted}}" />
            <Picker Title="Filtrar solicitudes" ItemsSource="{Binding Filtros}" SelectedIndex="{Binding FiltroSeleccionado, Mode=TwoWay}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource NightInk}}"
                    MinimumHeightRequest="48" SemanticProperties.Description="Filtro de disponibilidad" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding ResumenBusqueda}" Style="{StaticResource TextoVisual}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Nueva solicitud" Command="{Binding NuevaSolicitudCommand}" Style="{StaticResource PrincipalVisual}" />
            </Grid>
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" x:Name="Listado" ItemsSource="{Binding Solicitudes}"
                        SelectionMode="None" ItemsUpdatingScrollMode="KeepScrollOffset" Scrolled="Listado_Scrolled">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" Spacing="8">
                    <Label Text="{Binding TituloListaVacia}" Style="{StaticResource TituloVisual}" />
                    <Label Text="{Binding DescripcionListaVacia}" Style="{StaticResource TextoVisual}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SolicitudGestion">
                    <Border Style="{StaticResource TarjetaVisual}" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Label Text="{Binding CodigoSolicitud}" Style="{StaticResource TituloVisual}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Más" Clicked="Opciones_Clicked" Style="{StaticResource AccionVisual}"
                                        SemanticProperties.Description="{Binding CodigoSolicitud, StringFormat='Más acciones para {0}'}" />
                            </Grid>
                            <Label Text="{Binding EstadoGestion}" FontAttributes="Bold" Style="{StaticResource TextoVisual}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding EnJornadaActiva}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkBlue}, Dark={StaticResource NightBlue}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding EstadoGestion}" Value="Ubicación pendiente">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource NightAmber}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding EstadoGestion}" Value="Disponible para jornada">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryGreen}, Dark={StaticResource NightGreen}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding ZonaVisible}" Style="{StaticResource TextoVisual}" />
                            <Label Text="{Binding DireccionReferencia}" Style="{StaticResource TextoVisual}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Label Text="{Binding Unidades, StringFormat='{0} unidades físicas'}" Style="{StaticResource TextoVisual}" />
                                <Label Grid.Column="1" Text="{Binding PesoTotalEstimado, StringFormat='{0:0.##} kg estimados'}" Style="{StaticResource TextoVisual}" />
                            </Grid>
                            <Label IsVisible="{Binding TieneFecha}" Text="{Binding FechaProgramada, StringFormat='Fecha programada · {0:dd/MM/yyyy}'}"
                                   TextColor="{AppThemeBinding Light={StaticResource InkBlue}, Dark={StaticResource NightBlue}}" />
                            <Label Text="{Binding ContactoVisible}" Style="{StaticResource TextoVisual}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Ver detalles" Clicked="Detalle_Clicked" Style="{StaticResource AccionVisual}" />
                                <Button Grid.Column="1" Text="Editar" Clicked="Editar_Clicked" Style="{StaticResource AccionVisual}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
