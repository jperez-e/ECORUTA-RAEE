<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ECORUTA_RAEE.Views.SolicitudesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Solicitudes"
    BackgroundColor="#F4F7F4">

    <Grid RowDefinitions="Auto,*">

        <!-- Encabezado -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="22,22,22,16"
            Spacing="16">

            <Label
                Text="GESTIÓN DE RECOLECCIÓN"
                FontSize="11"
                FontAttributes="Bold"
                CharacterSpacing="1.5"
                TextColor="#218653"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">

                <VerticalStackLayout Spacing="5">
                    <Label
                        Text="Mis solicitudes"
                        FontSize="29"
                        FontAttributes="Bold"
                        TextColor="#183D2B"/>

                    <Label
                        Text="Consulta el estado de tus recogidas."
                        FontSize="14"
                        TextColor="#718078"/>
                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="52"
                    HeightRequest="52"
                    BackgroundColor="#DFF2E3"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">

                    <Label
                        Text="♻"
                        FontSize="29"
                        TextColor="#218653"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Resumen -->
            <Border
                Padding="18"
                BackgroundColor="#17452F"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        Spacing="5">

                        <Label
                            Text="SOLICITUDES REGISTRADAS"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            TextColor="#D4E9D9"/>

                        <Label
                            Text="Sigue el progreso de tus recogidas"
                            FontSize="13"
                            TextColor="White"/>
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        Padding="15,8"
                        BackgroundColor="#B7F36B"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding TotalSolicitudes}"
                            FontSize="25"
                            FontAttributes="Bold"
                            TextColor="#183D2B"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Acción principal -->
            <Button
                Text="+   Nueva solicitud"
                Command="{Binding NuevaSolicitudCommand}"
                BackgroundColor="#218653"
                TextColor="White"
                FontSize="15"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="52"/>

            <Label
                Text="HISTORIAL DE SOLICITUDES"
                FontSize="11"
                FontAttributes="Bold"
                CharacterSpacing="1.2"
                TextColor="#718078"/>
        </VerticalStackLayout>

        <!-- Lista -->
        <CollectionView
            Grid.Row="1"
            Margin="22,0,22,10"
            ItemsSource="{Binding Solicitudes}"
            SelectionMode="None">

            <!-- Estado vacío -->
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="24"
                    Spacing="12"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="86"
                        HeightRequest="86"
                        BackgroundColor="#E4F2E6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        HorizontalOptions="Center">

                        <Label
                            Text="♻"
                            FontSize="43"
                            TextColor="#218653"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>
                    </Border>

                    <Label
                        Text="Todavía no hay solicitudes"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#26352B"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Cuando registres una recogida, aparecerá aquí para que puedas consultar sus datos."
                        FontSize="13"
                        TextColor="#718078"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center"
                        MaximumWidthRequest="300"
                        LineHeight="1.3"/>

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Tarjeta de cada solicitud -->
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Margin="0,0,0,14"
                        Padding="17"
                        BackgroundColor="White"
                        Stroke="#E1E9E2"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 19">

                        <VerticalStackLayout Spacing="13">

                            <!-- Código y estado -->
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">

                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="CÓDIGO DE SOLICITUD"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1"
                                        TextColor="#89958D"/>

                                    <Label
                                        Text="{Binding CodigoSolicitud}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#218653"/>
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="1"
                                    Padding="10,6"
                                    BackgroundColor="#FFF1D2"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center">

                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding Estado}"
                                            Value="En proceso">
                                            <Setter
                                                Property="BackgroundColor"
                                                Value="#DDEBFF"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding Estado}"
                                            Value="Completada">
                                            <Setter
                                                Property="BackgroundColor"
                                                Value="#DDF4E2"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding Estado}"
                                            Value="Cancelada">
                                            <Setter
                                                Property="BackgroundColor"
                                                Value="#FCE4E4"/>
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Label
                                        Text="{Binding Estado}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#8A6415"
                                        VerticalTextAlignment="Center">

                                        <Label.Triggers>
                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding Estado}"
                                                Value="En proceso">
                                                <Setter
                                                    Property="TextColor"
                                                    Value="#245DA8"/>
                                            </DataTrigger>

                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding Estado}"
                                                Value="Completada">
                                                <Setter
                                                    Property="TextColor"
                                                    Value="#176B3A"/>
                                            </DataTrigger>

                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding Estado}"
                                                Value="Cancelada">
                                                <Setter
                                                    Property="TextColor"
                                                    Value="#B42323"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#E8EEE9"/>

                            <!-- Zona -->
                            <Grid ColumnDefinitions="30,*"
                                  ColumnSpacing="9">

                                <Label
                                    Text="⌖"
                                    FontSize="23"
                                    TextColor="#218653"
                                    VerticalTextAlignment="Start"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4">

                                    <Label
                                        Text="Zona de recogida"
                                        FontSize="11"
                                        TextColor="#89958D"/>

                                    <Label
                                        Text="{Binding Zona}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#26352B"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Dirección -->
                            <Grid ColumnDefinitions="30,*"
                                  ColumnSpacing="9">

                                <Label
                                    Text="⌂"
                                    FontSize="22"
                                    TextColor="#218653"
                                    VerticalTextAlignment="Start"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4">

                                    <Label
                                        Text="Dirección o referencia"
                                        FontSize="11"
                                        TextColor="#89958D"/>

                                    <Label
                                        Text="{Binding DireccionReferencia}"
                                        FontSize="13"
                                        TextColor="#526158"
                                        LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Peso y fecha -->
                            <Border
                                Padding="12"
                                BackgroundColor="#F4F8F4"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 13">

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="12">

                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            Text="PESO ESTIMADO"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="#89958D"/>

                                        <Label
                                            Text="{Binding PesoTotalEstimado, StringFormat='{0:F2} kg'}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#218653"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="4">

                                        <Label
                                            Text="FECHA DE REGISTRO"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="#89958D"/>

                                        <Label
                                            Text="{Binding FechaRegistro, StringFormat='{0:dd/MM/yyyy}'}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="#34423A"/>

                                        <Label
                                            Text="{Binding FechaRegistro, StringFormat='{0:hh:mm tt}'}"
                                            FontSize="11"
                                            TextColor="#718078"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
